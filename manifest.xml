<!-- Device VINTF manifest for Motorola SM8635 (arcfox).
     Copied from the shipping firmware's /vendor/etc/vintf/manifest_pineapple.xml.
     The stock <sepolicy> block was REMOVED: it declares 34.0, and assemble_vintf
     injects BOARD_SEPOLICY_VERS (202504 on LineageOS 23.2) itself, failing with
     "Cannot override existing value 34.0 with BOARD_SEPOLICY_VERS". -->
<!--
    Input:
        device/qcom/pineapple/manifest_pineapple.xml
-->
<manifest version="7.0" type="device" target-level="8">
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <fqname>@7.1::IDevicesFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <fqname>@7.0::IEffectsFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IBluetoothHci/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <hal format="aidl">
        <name>android.hardware.nfc</name>
        <fqname>INfc/default</fqname>
    </hal>
    <hal format="hidl">
        <name>com.dsi.ant</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IAnt/default</fqname>
    </hal>
    <hal format="hidl">
        <name>com.qualcomm.qti.dpm.api</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IdpmQmi/dpmQmiService</fqname>
    </hal>
    <hal format="hidl">
        <name>com.qualcomm.qti.imscmservice</name>
        <transport>hwbinder</transport>
        <fqname>@2.2::IImsCmService/qti.ims.connectionmanagerservice</fqname>
    </hal>
    <hal format="hidl">
        <name>com.qualcomm.qti.uceservice</name>
        <transport>hwbinder</transport>
        <fqname>@2.3::IUceService/com.qualcomm.qti.uceservice</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.nxp.nxpnfc_aidl</name>
        <fqname>INxpNfc/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.bluetooth_audio</name>
        <transport>hwbinder</transport>
        <fqname>@2.1::IBluetoothAudioProvidersFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.bluetooth_sar</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IBluetoothSar/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.btconfigstore</name>
        <transport>hwbinder</transport>
        <fqname>@2.0::IBTConfigStore/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.cacert</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IService/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.capabilityconfigstore</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ICapabilityConfigStore/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.dsp</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IDspService/dspservice</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.fm</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IFmHci/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.secureprocessor.device</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISecureProcessor/qti-tee</fqname>
        <fqname>@1.0::ISecureProcessor/qti-tvm</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.wifi.wifilearner</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IWifiStats/wifiStats</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.ims.callinfo</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IService/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.ims.factory</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IImsFactory/default</fqname>
    </hal>

    <!-- From stock manifest_cliffs.xml (SM8635 codename is cliffs; stock
         selects it at runtime via ro.boot.product.vendor.sku). Only entries
         whose services we actually ship are merged. -->
    <hal format="aidl">
        <name>android.hardware.biometrics.fingerprint</name>
        <version>3</version>
        <fqname>IFingerprint/default</fqname>
    </hal>
    <hal format="aidl">
        <name>com.motorola.hardware.biometric.fingerprint</name>
        <version>3</version>
        <fqname>IMotoCaptiveSensorTest/default</fqname>
        <fqname>IMotoFingerPrint/default</fqname>
        <fqname>IMotoFpsNavigate/default</fqname>
    </hal>
    <hal format="hidl" override="true">
        <name>com.motorola.hardware.display.touch</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::IMotTouch/default</fqname>
    </hal>
    <!-- android.hardware.media.c2 IComponentStore is NOT declared here, and must
         not be. NOTHING IN THIS FILE REACHES THE DEVICE AT RUNTIME.
         ro.boot.product.vendor.sku is "cliffs", and
         VintfObject::fetchVendorHalManifest() (VintfObject.cpp:359-384) is a
         PRIORITY CHAIN, not a merge: it reads
         /vendor/etc/vintf/manifest_${vendor.sku}.xml and returns, only falling
         back to manifest.xml when that file is absent or the SKU is empty. Stock
         ships manifest_cliffs.xml, and we ship it verbatim as a blob, so this
         file is inert. Proven on the running device: a unique probe HAL injected
         into /vendor/etc/vintf/manifest.xml never appears in `vintf dm`, while
         the same entry in a fragment does. Two commits (e2649eb, f475181) tried
         to declare `default` here and neither had any effect; the second was
         mis-diagnosed as a version problem when the file was simply not read.
         The declaration now lives in a fragment, which IS always merged:
         device/motorola/sm8635-common/vintf/manifest_media_c2.xml.
         This file still has to exist -- it is DEVICE_MANIFEST_FILE, and
         check_vintf fails image assembly without it -- so it is a BUILD-TIME
         compatibility input only. Do not add runtime-critical declarations. -->

    <!-- motorola.hardware.camera.desktop REMOVED. It was declared here while
         /vendor/bin/hw/motorola.hardware.camera.desktop@2.0-service is labelled
         vendor_file, so init never started it: exactly the declared-but-absent
         condition the Dolby codec2 removal is about, sitting in our own manifest.
         It has been survivable only by accident: hwservicemanager's
         ServiceManager::getTransport returns Transport::EMPTY when the SELinux
         `find` check fails, which makes getService() return a prompt nullptr
         instead of blocking. In other words the avc denial was load-bearing.
         Adding the hwservice_contexts entry without removing this declaration
         would have handed the camera provider a HWBINDER transport for an
         instance nothing serves, and hung it in the infinite retry loop.
         Stock declares this HAL only in manifest_cliffs.xml, a different SKU. -->

    <hal format="hidl">
        <name>vendor.zui.hardware.ifaa</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IIFAADevice/default</fqname>
    </hal>

</manifest>
