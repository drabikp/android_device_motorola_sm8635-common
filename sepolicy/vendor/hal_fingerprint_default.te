# The FPC fingerprint HAL starts and STAYS ALIVE -- it is not a crash loop -- but
# it never calls addService, so system_server polls
# android.hardware.biometrics.fingerprint.IFingerprint/default once a second
# forever. Three denials, all correlated to the HAL's pid, explain it:
#
#   { search }     tcontext=u:object_r:vendor_sysfs_devicetree_soc:s0 dir
#   { read write } name="smcinvoke" tcontext=u:object_r:tee_device:s0 chr_file
#   { set }        property=vendor.hw.fingerprint.status
#
# smcinvoke is the fatal one: the FPC matcher is a QTEE trusted app, so with
# /dev/smcinvoke denied the HAL can never finish init and never registers.
#
# Stock's equivalent domain (vendor_hal_fingerprint_fpc, a Motorola type we do
# not have) carries the same set plus the qseecom dma-buf heaps and input_device.
# Those are pre-granted here rather than discovered one boot cycle per denial --
# a denied process stops at the FIRST denial, so the three observed ones are not
# necessarily the complete blocking set.
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_fingerprint_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
allow hal_fingerprint_default vendor_sysfs_devicetree_soc:dir search;
allow hal_fingerprint_default vendor_sysfs_devicetree_soc:file r_file_perms;
allow hal_fingerprint_default input_device:chr_file rw_file_perms;
set_prop(hal_fingerprint_default, vendor_mot_fingerprint_status_prop)

# Round two, from the denials the rules above uncovered. The grants above worked:
# the HAL got past /dev/smcinvoke and stopped on these instead, so it is making
# progress through its init rather than failing at one fixed point.
#
#   avc: denied { write } name="uinput" tcontext=u:object_r:uhid_device:s0 chr_file
#   avc: denied { read }  name="u:object_r:build_bootimage_prop:s0" file
#
# The uhid one is the substantive one: the FPC HAL creates a virtual input device
# for the sensor, which is also why its rc asks for the `uhid` group.
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;
get_prop(hal_fingerprint_default, build_bootimage_prop)


# ---------------------------------------------------------------------------
# ROUND THREE, from a clean 75 s boot capture.
#
# FIRST, A CORRECTION TO THE HEADER ABOVE: the HAL now DOES register. Measured
# live on the running device --
#   `service check android.hardware.biometrics.fingerprint.IFingerprint/default`
#       -> found
#   `service list | grep -i finger`
#       -> 19 android.hardware.biometrics.fingerprint.IFingerprint/default: []
#          138 fingerprint: [android.hardware.fingerprint.IFingerprintService]
#   and android.hardware.biometrics.fingerprint-service.fpc is alive as pid 2771.
# The rules above worked. What follows are the denials that remain AFTER
# IFingerprint is up, so they are extensions, not the blocking set.
#
# 1) The three Motorola extension interfaces. See service_contexts for the
#    denials. They are refused because the names have no entry in any
#    service_contexts and therefore land on default_android_service, which no
#    vendor domain may add to.
#
#    SCOPE, honestly stated: registering them removes six denials per boot and
#    lets the HAL finish its startup sequence instead of erroring out of it.
#    It does NOT by itself enable fingerprint gestures -- the client side of
#    IMotoFpsNavigate is a Motorola framework component that this ROM does not
#    ship, and the AIDL interfaces are not declared in any VINTF manifest here.
#    If servicemanager still refuses the add after this change, the next thing to
#    check is the VINTF declaration, which is not this file's to edit.
add_service(hal_fingerprint_default, vendor_hal_motofingerprint_service)

# 2) /data/vendor/.fps -- the HAL's own state directory, which it creates on
#    first run:
#
#      avc: denied { write } for comm="android.hardwar" name=".fps" dev="dm-43"
#           scontext=u:r:hal_fingerprint_default:s0
#           tcontext=u:object_r:vendor_data_file:s0 tclass=dir
#
#    dm-43 is /data. The write is on the PARENT (/data/vendor), i.e. the mkdir
#    itself. Path and type are stock's (vendor_file_contexts:637); the type is
#    declared in file.te and the path in file_contexts, and the type_transition
#    is what makes the directory come out labelled correctly when the HAL creates
#    it rather than only after the next restorecon.
allow hal_fingerprint_default vendor_data_file:dir { search write add_name };
type_transition hal_fingerprint_default vendor_data_file:dir fps_data_file ".fps";
allow hal_fingerprint_default fps_data_file:dir create_dir_perms;
allow hal_fingerprint_default fps_data_file:file create_file_perms;
