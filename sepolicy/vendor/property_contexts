# Set by /vendor/bin/init.oem.hw.sh from UTAG data -- see sepolicy/vendor/init_hw.te.
# READ access for everyone else had to be granted back by hand; see property.te.
#
# Two different precedence rules keep the existing entries intact, and they are
# not the same rule:
#   - AOSP's ro.vendor.product.cpu.abilist{,32,64} carry `exact string`, and an
#     EXACT entry beats a prefix entry outright, length irrelevant.
#   - vendor.hw.fingerprint.status above and QCOM's vendor.hw.fm. are prefix
#     entries like these, so they win on being LONGER.
ro.vendor.hw.                   u:object_r:vendor_mot_hw_prop:s0
vendor.hw.                      u:object_r:vendor_mot_hw_prop:s0
ro.vendor.product.              u:object_r:vendor_mot_product_prop:s0
ro.vendor.mot.gki.              u:object_r:vendor_mot_init_prop:s0

# --- Motorola properties set by the 15 /vendor/bin services ported here. ---
#
# ro.vendor.mot.hw.  is stock's (vendor_property_contexts:438); it is what
# init.mmi.boot.sh writes ro.vendor.mot.hw.rkp_csr_uploaded into and what
# hardware_revisions.sh / init.mmi.touch.sh read ro.vendor.mot.hw.lid out of.
# It is LONGER than our ro.vendor.mot.gki. entry only in the sense of being a
# sibling -- the two prefixes do not overlap, so both apply.
ro.vendor.mot.hw.               u:object_r:vendor_mot_hw_prop:s0

# Set by /vendor/bin/init.mmi.boot.sh (see mmi_boot.te). All of these were
# falling through to vendor_default_prop, which a vendor domain is neverallowed
# to write, so each one needs a label the domain holds `set` on.
#   ro.vendor.bootreason      "coldboot" after a kpanic/wdt, else the
#                             "Last boot reason" line out of /proc/bootinfo
#   ro.vendor.boot_seq        the BOOT_SEQ counter from /proc/bootinfo
#   ro.vendor.manufacturedate the Last-Test-Station stamp decoded from FTI
#   ro.vendor.mot.iccid       from UTAG /proc/config/iccid
#   ro.vendor.mot.cust_md5    from UTAG /proc/config/cust_md5
# persist.vendor.boot.bootseq.history is stock's vendor_mot_boot_prop; it is
# folded into vendor_mot_init_prop here rather than dragging in a type whose
# other members (ro.boot.*) must NOT be relabelled -- see property.te.
ro.vendor.bootreason            u:object_r:vendor_mot_init_prop:s0
ro.vendor.boot_seq              u:object_r:vendor_mot_init_prop:s0
ro.vendor.manufacturedate       u:object_r:vendor_mot_init_prop:s0
ro.vendor.mot.iccid             u:object_r:vendor_mot_init_prop:s0
ro.vendor.mot.cust_md5          u:object_r:vendor_mot_init_prop:s0
persist.vendor.boot.bootseq.history  u:object_r:vendor_mot_init_prop:s0

