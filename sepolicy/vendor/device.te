# Motorola factory-data block devices. Neither type exists in AOSP or in QCOM's
# sepolicy_vndr -- both are Motorola's own, taken from stock's
# vendor_sepolicy.cil.
#
#   hw       (sda1, 8 MiB)   the per-SKU hardware descriptor UTAGs -> /proc/hw
#   utags    (sde6, 512 KiB) the per-unit config UTAGs             -> /proc/config
#   utagsBackup (sde7)       the mirror the driver falls back to
#
# Without these the partitions fell through to the generic block_device label
# and the utags driver could not open them; see kernel.te for the measurement.
type hw_block_device, dev_type;
type utags_block_device, dev_type;

# Two more Motorola partitions, needed by the apanic and init_block_perm
# domains. Both exist on arcfox -- verified against
# `ls /dev/block/platform/soc/1d84000.ufshc/by-name/` on the live device:
#
#   cid    (sde8)   the carrier/HAB id blob; init.mmi.block_perm.sh chowns it
#                   root:vendor_tcmd so tcmd can read it
#   kpan   (sde10)  the kernel-panic ring apanic_save.sh writes from pstore and
#                   apanic_copy.sh reads back into /data/vendor/dontpanic
#   logfs  (sde15)  the bootloader's own log area, read by apanic_copy.sh
#
# Types are stock's (vendor_file_contexts:870, :875, :879).
#
# NOT DECLARED, because arcfox has no such partition and a type nothing is
# labelled with is dead weight:
#   modem_hob_block_device  (hob, dhob)      -- absent from by-name
#   clogo_block_device      (clogo)          -- absent from by-name
#   psylogs_block_device    (logs-charging)  -- absent from by-name
type cid_block_device, dev_type;
type kpan_block_device, dev_type;
type bllogs_block_device, dev_type;

# /dev/mmi_sys_temp -- Motorola's system-temperature character device, opened
# read/write by thermal-engine and falling through to u:object_r:device:s0:
#
#   avc: denied { read write } for comm="thermal-engine-" name="mmi_sys_temp"
#        scontext=u:r:vendor_thermal-engine:s0 tcontext=u:object_r:device:s0
#        tclass=chr_file
#
# Stock uses QCOM's thermal_device (vendor_file_contexts:1191), but that type is
# only declared in sepolicy_vndr/legacy-um/legacy and this board resolves to
# sepolicy_vndr/sm8650 (UM_6_1_FAMILY per SEPolicy.mk), where it does not exist
# -- checkfc rejects it outright. Hence a local type with the same meaning.
type vendor_mmi_thermal_device, dev_type;
