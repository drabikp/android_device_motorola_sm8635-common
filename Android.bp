//
// SPDX-License-Identifier: Apache-2.0
//
// Declares the device/motorola/sm8635-common Soong namespace.
//
// Required because the generated vendor blueprints
// (vendor/motorola/{arcfox,sm8635-common}/Android.bp) import this namespace by
// path. Without a soong_namespace module here, soong bootstrap fails with:
//   "namespace device/motorola/sm8635-common does not exist"

soong_namespace {
    imports: [
        "hardware/qcom-caf/bootctrl",
        "hardware/qcom-caf/sm8650",
        "hardware/qcom-caf/wlan",
    ],
}

// The four directories the fstab mounts physical partitions onto INSIDE
// /vendor (firmware_mnt <- modem, dsp <- dsp, bt_firmware <- bluetooth,
// fsg <- fsg). They must exist in the image or all four are blocking `wait`
// mounts against a non-existent path, and firmware_class.path
// (/vendor/firmware_mnt/image) is unreachable.
//
// These were previously created by hand, after `mka vendorimage`, by
// workspace/inject-vendor-mountpoints.sh -- because PRODUCT_COPY_FILES cannot
// create an empty directory and Android 16's soong filesystem generator
// rejects installing a stub into a new top-level vendor directory
// ("Path is outside directory: ../firmware_mnt").
//
// `mkdir` is the module type that actually does this; hardware/qcom-caf/common
// declares bt_firmware, dsp and firmware_mnt this way already, so only fsg --
// which is Motorola-specific and has no upstream counterpart -- is declared
// here. With all four coming from the build, the post-build injection step is
// no longer needed.
mkdir {
    name: "vendor_fsg_mountpoint",
    dir: "fsg",
    vendor: true,
}

// Sensors VINTF fragment.
//
// It must be a fragment, not an entry in manifest.xml: libvintf reads
// /vendor/etc/vintf/manifest_${ro.boot.product.vendor.sku}.xml and returns,
// only falling back to manifest.xml when the SKU is empty. It is not empty here
// (stock ships no manifest.xml at all, just manifest_cliffs/pineapple), so
// everything in our manifest.xml is inert. Fragments are always merged.
//
// It also cannot go through PRODUCT_COPY_FILES: build/make/core/Makefile:148
// rejects VINTF metadata there. A prebuilt_etc is the same shape extract_utils
// generates for the vintf manifest blobs already shipped.
prebuilt_etc {
    name: "android.hardware.sensors-arcfox.xml",
    src: "vintf/android.hardware.sensors-arcfox.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

