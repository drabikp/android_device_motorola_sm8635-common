//
// SPDX-License-Identifier: Apache-2.0
//
// Declares the device/motorola/sm8635-common Soong namespace.
//
// Required because the generated vendor blueprints
// (vendor/motorola/{arcfox,sm8635-common}/Android.bp) import this namespace by
// path. Without a soong_namespace module here, soong bootstrap fails with:
//   "namespace device/motorola/sm8635-common does not exist"

soong_namespace {
    imports: [
        "hardware/qcom-caf/bootctrl",
        "hardware/qcom-caf/sm8650",
        "hardware/qcom-caf/wlan",
    ],
}

// The four directories the fstab mounts physical partitions onto INSIDE
// /vendor (firmware_mnt <- modem, dsp <- dsp, bt_firmware <- bluetooth,
// fsg <- fsg). They must exist in the image or all four are blocking `wait`
// mounts against a non-existent path, and firmware_class.path
// (/vendor/firmware_mnt/image) is unreachable.
//
// These were previously created by hand, after `mka vendorimage`, by
// workspace/inject-vendor-mountpoints.sh -- because PRODUCT_COPY_FILES cannot
// create an empty directory and Android 16's soong filesystem generator
// rejects installing a stub into a new top-level vendor directory
// ("Path is outside directory: ../firmware_mnt").
//
// `mkdir` is the module type that actually does this; hardware/qcom-caf/common
// declares bt_firmware, dsp and firmware_mnt this way already, so only fsg --
// which is Motorola-specific and has no upstream counterpart -- is declared
// here. With all four coming from the build, the post-build injection step is
// no longer needed.
mkdir {
    name: "vendor_fsg_mountpoint",
    dir: "fsg",
    vendor: true,
}

// Sensors VINTF fragment.
//
// It must be a fragment, not an entry in manifest.xml: libvintf reads
// /vendor/etc/vintf/manifest_${ro.boot.product.vendor.sku}.xml and returns,
// only falling back to manifest.xml when the SKU is empty. It is not empty here
// (stock ships no manifest.xml at all, just manifest_cliffs/pineapple), so
// everything in our manifest.xml is inert. Fragments are always merged.
//
// It also cannot go through PRODUCT_COPY_FILES: build/make/core/Makefile:148
// rejects VINTF metadata there. A prebuilt_etc is the same shape extract_utils
// generates for the vintf manifest blobs already shipped.
prebuilt_etc {
    name: "android.hardware.sensors-arcfox.xml",
    src: "vintf/android.hardware.sensors-arcfox.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

// Codec2 IComponentStore fragment. Same reason as the sensors one above, and it
// was learned the hard way a second time: two commits declared
// android.hardware.media.c2 IComponentStore/default in manifest.xml, and both
// were inert, because ro.boot.product.vendor.sku is "cliffs" on this device so
// libvintf reads manifest_cliffs.xml and RETURNS -- VintfObject.cpp:359-384 is a
// priority chain, not a merge. Proof, on the running device: injecting a unique
// probe HAL into /vendor/etc/vintf/manifest.xml never appears in `vintf dm`,
// while the identical entry in a fragment does.
//
// See the file itself for why both stores are declared in one <hal> at @1.2.
prebuilt_etc {
    name: "manifest_media_c2.xml",
    src: "vintf/manifest_media_c2.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

// Restores the USB gadget config that init.mmi.usb.rc blanks, which is what
// gives us adb. See the file itself for the full mechanism and the trigger
// ordering that makes `on early-boot` the only correct place for it.
prebuilt_etc {
    name: "init.arcfox-usb.rc",
    src: "init/init.arcfox-usb.rc",
    sub_dir: "init",
    vendor: true,
}

// Starts the WiFi HAL, which had no init rc at all. See the file for the kernel
// state that makes this worthwhile and for why the VINTF declaration must wait
// for a separate cycle.
prebuilt_etc {
    name: "init.arcfox-wifi.rc",
    src: "init/init.arcfox-wifi.rc",
    sub_dir: "init",
    vendor: true,
}

// WiFi VINTF declaration. Ships only after bc25 proved the service reaches
// addService and fails solely on the missing declaration (-3). See the file.
prebuilt_etc {
    name: "android.hardware.wifi-arcfox.xml",
    src: "vintf/android.hardware.wifi-arcfox.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

// Starts the ST NFC HAL. The blob rc's start trigger depends on an init.svc.*
// property that can never exist on this build. No VINTF change goes with it --
// INfc/default is already declared. See the file.
prebuilt_etc {
    name: "init.arcfox-nfc.rc",
    src: "init/init.arcfox-nfc.rc",
    sub_dir: "init",
    vendor: true,
}

// Arms the touch controller's double-tap wake gesture by writing the Motorola
// touchscreen class node. Nothing on this ROM wrote it -- stock does it from a
// closed Moto HAL whose client apps we do not ship, and the LineageOS client
// (PowerManagerService -> IPower.setMode(DOUBLE_TAP_TO_WAKE)) lands in a
// Motorola power-HAL PREBUILT that ignores the mode. The file documents the
// decimal-only node contract and why the trigger is compound.
prebuilt_etc {
    name: "init.arcfox-touch-gesture.rc",
    src: "init/init.arcfox-touch-gesture.rc",
    sub_dir: "init",
    vendor: true,
}


// Face unlock VINTF declaration, replacing the hand-edited blob. See the file
// for why version 3 and not the 4 the vendor tree had been carrying.
prebuilt_etc {
    name: "android.hardware.biometrics.face-arcfox.xml",
    src: "vintf/android.hardware.biometrics.face-arcfox.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

// The android.hardware.biometrics.face system feature. Ships in the same change
// as the exec label, never before it -- see the VINTF file.
prebuilt_etc {
    name: "android.hardware.biometrics.face.xml",
    src: "permissions/android.hardware.biometrics.face.xml",
    sub_dir: "permissions",
    vendor: true,
}

// QSPA modem selector. Installed to /system_ext/etc/init, NOT /vendor/etc/init:
// it sets a ro.boot.* property, which is labelled bootloader_prop, and
// vendor_init has no permission to write that context. See the file itself for
// why neither a .prop nor BOARD_BOOTCONFIG/BOARD_KERNEL_CMDLINE can do this on
// this device.
prebuilt_etc {
    name: "init.arcfox-qspa.rc",
    src: "init/init.arcfox-qspa.rc",
    sub_dir: "init",
    system_ext_specific: true,
}
