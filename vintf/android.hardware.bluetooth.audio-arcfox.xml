<!--
    SPDX-License-Identifier: Apache-2.0

    Bluetooth audio provider, declared at the version Motorola's provider
    implements (stock declares exactly this, in vendor/etc/vintf/manifest/
    bluetooth_audio.xml).

    The provider is android.hardware.bluetooth.audio-impl-qti, a stock blob. It
    is not a service of its own: btaudio_offload_if.so (loaded by the audio HAL
    when it initialises A2DP offload) calls its createIBluetoothAudioProviderFactory,
    which registers IBluetoothAudioProviderFactory/default from inside the audio
    HAL process. The audio HAL's PAL listens only to that provider's sessions.
    Without this declaration servicemanager refuses the registration and the
    Bluetooth stack has no audio provider at all (see common.mk).
-->
<manifest version="1.0" type="device">
    <hal format="aidl">
        <name>android.hardware.bluetooth.audio</name>
        <version>3</version>
        <fqname>IBluetoothAudioProviderFactory/default</fqname>
    </hal>
</manifest>
