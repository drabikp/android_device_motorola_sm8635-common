<?xml version="1.0" encoding="utf-8"?>
<!-- Device framework compatibility matrix for Motorola SM8635 (arcfox).

     GENERATED from the exact HAL list checkvintf reported as incompatible:
       "check_vintf_compatible.log ... INCOMPATIBLE"
     Every entry is marked optional="true": these are vendor HALs the stock
     image provides and the AOSP framework matrices do not know about. Without
     this file the build fails at the check_vintf_compatible step with a list of
     ~30 unrecognised vendor.qti.* / com.qualcomm.* / motorola.* interfaces.

     Do NOT hand-edit: regenerate from the log if the vendor manifest changes. -->
